  "item": [
    {
      "name": "Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"response to be 200 OK\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Product 1 tests\r",
              "pm.test(\"value of [0].Id to be 1\", () => {\r",
              "    pm.expect(jsonData[0].Id).to.equal(1);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [0].Name to be 'Keyboard'\", () => {\r",
              "    pm.expect(jsonData[0].Name).to.equal(\"Keyboard\");\r",
              "});\r",
              "\r",
              "pm.test(\"value of [0].Price to be 25\", () => {\r",
              "    pm.expect(jsonData[0].Price).to.equal(25);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [0].Description to be 'Mechanical keyboard'\", () => {\r",
              "    pm.expect(jsonData[0].Description).to.equal(\"Mechanical keyboard\");\r",
              "});\r",
              "\r",
              "// Product 2 tests\r",
              "pm.test(\"value of [1].Id to be 2\", () => {\r",
              "    pm.expect(jsonData[1].Id).to.equal(2);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [1].Name to be 'Mouse'\", () => {\r",
              "    pm.expect(jsonData[1].Name).to.equal(\"Mouse\");\r",
              "});\r",
              "\r",
              "pm.test(\"value of [1].Price to be 15\", () => {\r",
              "    pm.expect(jsonData[1].Price).to.equal(15);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [1].Description to be 'Wireless mouse'\", () => {\r",
              "    pm.expect(jsonData[1].Description).to.equal(\"Wireless mouse\");\r",
              "});\r",
              "\r",
              "// Product 3 tests\r",
              "pm.test(\"value of [2].Id to be 3\", () => {\r",
              "    pm.expect(jsonData[2].Id).to.equal(3);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [2].Name to be 'Monitor'\", () => {\r",
              "    pm.expect(jsonData[2].Name).to.equal(\"Monitor\");\r",
              "});\r",
              "\r",
              "pm.test(\"value of [2].Price to be 200\", () => {\r",
              "    pm.expect(jsonData[2].Price).to.equal(200);\r",
              "});\r",
              "\r",
              "pm.test(\"value of [2].Description to be '24 inch monitor'\", () => {\r",
              "    pm.expect(jsonData[2].Description).to.equal(\"24 inch monitor\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
